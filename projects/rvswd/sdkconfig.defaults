CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Operator-confirmed adapter: 4 MB physical Flash.
# PSRAM is not needed, and GPIO16/17 are deliberately left untouched.
CONFIG_SPIRAM=n
CONFIG_XTAL_FREQ_40=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Enable the confirmed board profile, not automatic GPIO driving or target validation.
CONFIG_DIAG_BOARD_PINS_VERIFIED=y
CONFIG_DIAG_BOARD_NAME="ESP32-D0WD-V3 rev3.1 CP2102 GPIO25-26"
CONFIG_DIAG_HALF_PERIOD_US=250
CONFIG_DIAG_TURNAROUND_US=50
